# Identixia Face Liveness — local environment
# Shell / Compose variables already set still win.

# License key — paste here, or POST /api/activate (writes LICENSE into this file).
LICENSE=

# HTTP API — bind address and port (0.0.0.0 = reachable from other machines)
HOST=0.0.0.0
PORT=14105

# Gradio demo — bind address and port
DEMO_HOST=0.0.0.0
DEMO_PORT=14205

# When the demo runs on a different host than the API, set the API URL explicitly:
# API_BASE=http://192.168.1.10:14105
